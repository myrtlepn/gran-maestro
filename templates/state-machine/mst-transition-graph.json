  "lifecycle_contract": {
    "cleanup_boundary": {
      "after": [
        "target_branch_reflection"
      ],
      "not_responsibility": [
        "commit",
        "merge",
        "target_ref_update"
      ],
      "responsibility": [
        "worktree_remove",
        "git_worktree_prune",
        "meta_cleanup",
        "branch_delete_or_archive"
      ]
    },
    "delegation_launch_surface": {
      "authoritative_owner": "mst_protected_external_lifecycle",
      "execution_transport": "external",
      "launch_surfaces": [
        "direct",
        "orca"
      ],
      "orca_contract": {
        "cleanup": {
          "failed_cancelled_unknown": "preserve_terminal",
          "provider_reconciliation": "return_controller_and_preserve_terminal",
          "successful_cleanup_ready": "out_of_tab_controller_close_tab",
          "successful_provider_finalized": "persist_history_then_mark_cleanup_ready",
          "worker_pre_run_failure": "record_reconciliation_then_return_controller",
          "worker_stale_heartbeat": "bounded_reconciliation_then_preserve_terminal"
        },
        "create_boundary": {
          "after_invocation": "reconcile_without_fallback_or_duplicate_execution",
          "before_invocation": "original_route_fallback_allowed"
        },
        "reacquisition_identity": [
          "exact_path_selector",
          "deterministic_terminal_title"
        ],
        "protected_context": {
          "enforcement": "provider_spawn_boundary_all_entrypoints",
          "precedence": "bound_artifact_over_inherited_environment",
          "orca_cli_command": "not_forwarded_to_provider",
          "provider_output": "exact_context_value_redacted_before_persistence",
          "structured_context": "private_hash_bound_artifact_then_provider_environment"
        },
        "runtime_scope": "local_only",
        "worktree_selector": "path:<absolute-mst-worktree>"
      },
      "providers": [
        "codex",
        "claude",
        "agy"
      ]
    },
    "id": "worktree-accept-cleanup-lifecycle",
    "ordered_steps": [
      {
        "id": "worktree_create",
        "label": "worktree 생성",
        "next": "worktree_work",
        "order": 1,
        "required_evidence": [
          "worktree_path",
          "task_branch"
        ]
      },
      {
        "id": "worktree_work",
        "label": "worktree 안에서 작업",
        "next": "commit_intended_changes",
        "order": 2,
        "required_evidence": [
          "worktree_path"
        ]
      },
      {
        "id": "commit_intended_changes",
        "label": "의도한 변경만 커밋",
        "next": "accept_child_to_session",
        "order": 3,
        "required_evidence": [
          "phase2_commit_evidence",
          "branch_head_matches_recorded_commit"
        ]
      },
      {
        "id": "accept_child_to_session",
        "label": "accept/merge 단계에서 정해진 대상 브랜치로 merge",
        "next": "target_branch_reflection",
        "order": 4,
        "required_evidence": [
          "child_merge_queue",
          "idempotency_key",
          "child_to_session"
        ],
        "scope": {
          "child_to_session": true,
          "session_to_original": false
        }
      },
      {
        "id": "target_branch_reflection",
        "label": "selected target branch reflection evidence 확인",
        "next": "post_merge_cleanup",
        "order": 5,
        "required_evidence": [
          "target_before",
          "accepted_commit",
          "target_after",
          "accepted_commit_is_ancestor_of_target"
        ]
      },
      {
        "allowed_actions": [
          "worktree_remove",
          "git_worktree_prune",
          "meta_cleanup",
          "branch_delete_or_archive"
        ],
        "forbidden_actions": [
          "commit",
          "merge",
          "target_ref_update"
        ],
        "id": "post_merge_cleanup",
        "label": "merge 성공 후 cleanup에서 worktree 제거, prune, meta 정리",
        "next": "phase5_done",
        "order": 6,
        "required_evidence": [
          "cleanup_boundary",
          "worktree_remove_result",
          "meta_cleanup_result"
        ]
      },
      {
        "id": "phase5_done",
        "label": "Phase 5 done",
        "order": 7,
        "required_evidence": [
          "target_branch_reflection",
          "cleanup_result"
        ],
        "terminal": true
      }
    ],
